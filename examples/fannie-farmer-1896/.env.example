# Copy this file to .env in the same folder and fill in the key.
# .env is ignored by git; never commit real keys. The cookbook command reads it
# from the book's folder on every run, and never overrides a variable already
# set in your shell.

# --- AI models: cookbook ingest (reading recipe cards) and cookbook photo ---
# Only those two commands need it. Create a key at
# https://aistudio.google.com/apikey
# They also need the engine's AI extra:
#   pip install "family-cookbook[ai] @ git+https://github.com/scanady/family-cookbook@v1.0.0"
GEMINI_API_KEY=
